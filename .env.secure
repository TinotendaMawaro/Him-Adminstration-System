# ════════════════════════════════════════════════════════════════════════════
#  HIM Administration System - Secure Environment Configuration
#  XAMPP MySQL Security Hardening Guide
# ════════════════════════════════════════════════════════════════════════════

# ── APP ───────────────────────────────────────────────────────────────────────
APP_NAME="HIM Administration System"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=http://localhost

# ── DATABASE - XAMPP SECURE CONFIGURATION ────────────────────────────────────
# IMPORTANT: Run: php database/secure_setup.php first
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pastor_portal

# RESTRICTED USER - Only SELECT/INSERT/UPDATE on specific tables
# DO NOT USE root for application connections
DB_USERNAME=pastor_api
DB_PASSWORD=ChangeMeAfterRunningSecureSetupScript123!

# ── CACHING ──────────────────────────────────────────────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── LOGGING ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error

# Enable detailed audit logging for sensitive data access
DB_AUDIT_ENABLED=true

# ── SANCTUM API TOKENS ────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=localhost

# ── SECURITY HEADERS (set via middleware) ─────────────────────────────────────
# These headers are added by SecureApiMiddleware:
#   X-Content-Type-Options: nosniff
#   X-Frame-Options: DENY
#   X-XSS-Protection: 1; mode=block
#   Referrer-Policy: strict-origin-when-cross-origin
#   Permissions-Policy: geolocation=(), microphone=(), camera=()

# ── RATE LIMITING ─────────────────────────────────────────────────────────────
# Default: 60 requests per minute per user
# Members endpoint: 120 requests per minute
# Login: 10 attempts per minute
# Register: 3 per minute

# ── MAIL (Optional - for notifications) ───────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@him.local
MAIL_FROM_NAME="${APP_NAME}"

# ════════════════════════════════════════════════════════════════════════════
#  ⚠️  POST-INSTALL STEPS:
#  1. Run: php database/secure_setup.php
#  2. Generated credentials will be printed - update DB_USERNAME & DB_PASSWORD
#  3. Run: php artisan migrate
#  4. Run: php artisan db:seed (create admin accounts)
#  5. Clear config cache: php artisan config:clear
#  6. Test connection: php artisan migrate:status
#
#  🛡️  Security Checklist:
#  [x] Restricted DB user (SELECT/INSERT/UPDATE only)
#  [x] Role-based access control on all endpoints
#  [x] Rate limiting applied
#  [x] Audit logging enabled
#  [x] Security headers added via middleware
#  [x] No sensitive data in error responses
#  [x] No root/privileged DB user in .env
#  [x] Prepared statements enforced (Eloquent)
#  [x] HTTPS recommended (for production)
# ════════════════════════════════════════════════════════════════════════════
